# hala-clean-commercial-engine — environment (SC-01.1)
# Copy to .env and fill in. This package reads ONLY its own .env; nothing is
# inherited from hala-commercial-engine.

# Shared Supabase business database — the accepted external service for SC-01.
# The anon key is public-by-design (it ships in any client bundle).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Clean-owned server (document/PDF capabilities from SC-01.4).
CLEAN_SERVER_PORT=5301
